      },
      {
        "from": 1,
        "to": 0,
        "label": "acquired",
        "kind": "reply",
        "note": "Qulf bo'sh edi — Thread 1 oldi"
      },
      {
        "from": 0,
        "to": 0,
        "kind": "note",
        "label": "critical section",
        "note": "Thread 1 umumiy resurs bilan ishlayapti"
      },
      {
        "from": 2,
        "to": 1,
        "label": "lock()",
        "note": "Thread 2 ham qulfni so'raydi"
      },
      {
        "from": 2,
        "to": 2,
        "kind": "note",
        "label": "blocked (waiting)",
        "note": "Qulf band: Thread 2 kutadi"
      },
      {
        "from": 0,
        "to": 1,
        "label": "unlock()",
        "note": "Thread 1 ishini tugatib qulfni qo'yib yuboradi"
      },
      {
        "from": 1,
        "to": 2,
        "label": "acquired",
        "kind": "reply",
        "note": "Endi qulf Thread 2 ga beriladi"
      }
    ]
  },
